{
  "name": "anasampaiohair",
  "private": true,
  "version": "2.0.0",
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  },
  "scripts": {
    "clean": "rm -rf dist .next",
    "dev": "next dev -p 3000",
    "local": "node scripts/local-dev.mjs",
    "local:prod": "node scripts/local-dev.mjs prod",
    "dev:clean": "npm run clean && next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "start:3010": "node scripts/free-port.mjs 3010 && next start -p 3010",
    "preview": "npm run build && node -e \"console.log('\\n→ Site: http://localhost:3010/pt\\n')\" && npm run start:3010",
    "preview:clean": "npm run clean && npm run preview",
    "lint": "next lint",
    "verify": "npm run audit:images && npm run optimize:images && npm run build && npm run smoke:prod",
    "smoke": "node scripts/smoke-routes.mjs",
    "test:routes": "npm run verify",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "sync:images-2026": "node scripts/sync-ana-img-2026.mjs && node scripts/update-blog-featured-2026.mjs && node scripts/generate-blog-image-dimensions.mjs",
    "sync:trabalhos-hero": "node scripts/sync-trabalhos-hero.mjs",
    "build:brand-lockup": "node scripts/build-brand-lockup.mjs",
    "build:favicons": "node scripts/build-favicons.mjs",
    "audit:images": "node scripts/audit-image-paths.mjs && node scripts/audit-next-image-local.mjs",
    "audit:images-source": "node scripts/audit-ana-img-source.mjs",
    "prune:images": "node scripts/prune-unused-public-images.mjs",
    "prune:images:apply": "node scripts/prune-unused-public-images.mjs --apply",
    "generate:blog-image-dimensions": "node scripts/generate-blog-image-dimensions.mjs",
    "sync:mechas-ana": "node scripts/sync-mechas-ana-portraits.mjs",
    "sync:coloracao-pessoal": "node scripts/sync-mechas-coloracao-pessoal.mjs",
    "optimize:images": "node scripts/optimize-public-images.mjs",
    "optimize:images:apply": "node scripts/optimize-public-images.mjs --apply",
    "build:assistant-avatar": "node scripts/build-assistant-avatar.mjs",
    "stamp:ana-rights": "node scripts/stamp-ana-image-rights.mjs"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.23",
    "eslint-plugin-react-hooks": "^7.1.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  }
}
